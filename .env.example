# Copia este fichero a .env y rellena las claves. NUNCA commitees .env.

# === LLM ===
# Proveedor del agente: "anthropic" (por defecto) u "ollama" (local, sin clave).
LLM_PROVIDER=anthropic

# Si LLM_PROVIDER=anthropic. Clave en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Si LLM_PROVIDER=ollama. El modelo debe soportar tool calling (p. ej. gemma4).
OLLAMA_MODEL=gemma4
OLLAMA_BASE_URL=http://localhost:11434

# === Embeddings ===
# Proveedor: "voyage" (por defecto), "openai" u "ollama" (local, sin clave).
EMBEDDINGS_PROVIDER=voyage

# Si EMBEDDINGS_PROVIDER=voyage. https://voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Si EMBEDDINGS_PROVIDER=openai (alternativa configurable)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Si EMBEDDINGS_PROVIDER=ollama (comparte OLLAMA_BASE_URL).
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Preset 100% local con Ollama (descomenta para no usar claves cloud) ---
# LLM_PROVIDER=ollama
# EMBEDDINGS_PROVIDER=ollama

# === Vector store (ChromaDB local) ===
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=dev_context
# Ficheros subidos desde el frontend (se conservan para leer fragmentos al citar).
UPLOADS_DIR=./.uploads

# === Retrieval / RAG ===
RETRIEVAL_TOP_K=8
CONTEXT_TOKEN_BUDGET=4000
# Aproximación de tokens por carácter para acotar el contexto (heurística offline).
CHARS_PER_TOKEN=3.5

# === API / CORS ===
# Orígenes del frontend permitidos, separados por comas.
CORS_ORIGINS=http://localhost:5173
