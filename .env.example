# Copia este fichero a .env y rellena las claves. NUNCA commitees .env.

# === LLM (Anthropic) ===
# Requerido para el agente (Fase 3+). Clave en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# === Embeddings ===
# Proveedor: "voyage" (por defecto) u "openai"
EMBEDDINGS_PROVIDER=voyage

# Requerido si EMBEDDINGS_PROVIDER=voyage (Fase 1+). https://voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Requerido si EMBEDDINGS_PROVIDER=openai (alternativa configurable)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Vector store (ChromaDB local) ===
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=dev_context

# === Retrieval / RAG ===
RETRIEVAL_TOP_K=8
CONTEXT_TOKEN_BUDGET=4000
# Aproximación de tokens por carácter para acotar el contexto (heurística offline).
CHARS_PER_TOKEN=3.5
